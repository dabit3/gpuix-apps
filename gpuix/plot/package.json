{
  "name": "gpuix-plot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live GPU charts in your terminal. plot -- <command> | plot data.csv",
  "bin": {
    "plot": "./bin/plot.tsx"
  },
  "scripts": {
    "dev": "GPUIX_TERMINAL=1 bun --hot bin/plot.tsx -- ping -i 0.2 1.1.1.1",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
