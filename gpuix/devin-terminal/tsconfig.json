{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "devin-zoom",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "paths": {
      "devin-zoom/*": [
        "./src/zoom/*"
      ]
    }
  },
  "include": [
    "src",
    "*.ts",
    "*.tsx",
    "assets.d.ts"
  ]
}
